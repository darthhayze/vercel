---
import WorldShell from '../../components/kit/WorldShell.astro';
import Sheet from './Sheet.astro';
import { FEATURES, SAMPLES, plotX, plotY } from './data';
import { tube, laptop } from '../../components/stage/glyphs';
import '../../components/stage/stage.css';
import './mass-spec.css';
interface Props { slug: string; c: any }
const { slug, c } = Astro.props;
const shown = FEATURES.slice(0, 8);
const rawOrder = [1, 3, 0, 5, 2, 4];
const format = (v: number) => v.toLocaleString('en-US');
const raw = shown.map(f => [f.id, ...rawOrder.map(i => format(f.raw[i]))]);
const reshaped = shown.map(f => [f.id, ...f.raw.map(format)]);
const stats = shown.map(f => [f.id, f.mA.toFixed(2), f.mB.toFixed(2), f.lfc.toFixed(2), f.p.toPrecision(3)]);
const first = FEATURES[0];
---
<WorldShell slug={slug} title={c.title} description={c.summary}>
  <div class="ms-world">
    <header class="ms-intro">
      <h1>Mass-spec macro</h1>
      <p>I wrote an Excel/VBA pipeline that reshapes mass-spec exports, runs t-tests and draws volcano plots for lab review.</p>
      <p class="ms-hint">Scroll through the workbook, or select Run macro to advance a step.</p>
      <p class="ms-note">Illustrative data throughout. The macro source and study data are private; the lab’s cleaning rules are not shown.</p>
    </header>
    <div class="ms-workbook" id="demo">
      <div class="ms-stage" data-stage-pin>
      <Sheet id="ms-sheet" name="raw_export" title="Start with the instrument export" formula="Read feature intensities across sample runs." headers={['Feature', ...rawOrder.map(i => SAMPLES[i])]} rows={raw} next="ms-reshaped">
        <p class="ms-table-note">Intensity by run. Compare the sample names across the columns.</p>
      </Sheet>
      <Sheet id="ms-reshaped" name="reshaped" title="Put the sample columns in order" formula="Keep one feature per row; place each group’s samples together." headers={['Feature', ...SAMPLES]} rows={reshaped} next="ms-flags" grouped>
        <div class="ms-group-key"><span>Group A: A1, A2, A3</span><span>Group B: B1, B2, B3</span></div>
      </Sheet>
      <Sheet id="ms-flags" name="reshaped" title="Flag cells for review" formula="Mark a missing intensity before comparing groups." headers={['Feature', 'A2', 'Review']} rows={[
        ['F01', 'Present', 'Complete'],
        ['F02', 'Missing', 'Check A2'],
        ['F03', 'Present', 'Complete'],
        ['F04', 'Present', 'Complete']
      ]} next="ms-stats">
        <p class="ms-table-note">This missing cell demonstrates a flag. The statistics below use the complete illustrative table.</p>
      </Sheet>
      <Sheet id="ms-stats" name="stats" title="Calculate the comparison" formula="Fill down group means, fold changes and t-test p-values." headers={['Feature', 'Mean A', 'Mean B', 'Log2 change', 'p-value']} rows={stats} next="ms-volcano">
        <p class="ms-table-note">For this example: means of log2 intensities, B minus A, and a two-sided Welch t-test.</p>
      </Sheet>
      <Sheet id="ms-volcano" name="volcano" title="Inspect the volcano plot" formula="Compare the size of each change with its p-value." next="ms-used">
        <div class="ms-chart-layout">
          <figure class="ms-chart">
            <p class="ms-axis-y">−log10(p-value) <span>↑ smaller p-value</span></p>
            <svg viewBox="0 0 600 380" aria-label="Volcano plot of illustrative features; horizontal position is log2 fold change, vertical position is negative log10 p-value." role="group">
              {[0, 2, 4, 6].map(y => <g><path class="ms-gridline" d={`M54 ${plotY(y)}H574`}/><text class="ms-tick" x="36" y={plotY(y) + 7} text-anchor="end">{y}</text></g>)}
              {[-3, 0, 3].map(x => <text class="ms-tick" x={plotX(x)} y="358" text-anchor="middle">{x}</text>)}
              <path class="ms-axis" d="M54 26V330H574"/>
              <path class="ms-zero" d={`M${plotX(0)} 26V330`}/>
              <path class="ms-cut" data-fold-cut d={`M${plotX(-1)} 26V330M${plotX(1)} 26V330`}/>
              <path class="ms-cut" data-p-cut d={`M54 ${plotY(-Math.log10(.05))}H574`}/>
              <g data-ms-points>{FEATURES.map((f, i) => <circle class={`ms-point ms-${f.cls}`} data-point={i} cx={plotX(f.lfc)} cy={plotY(f.nlp)} r="5.5" aria-label={`${f.id}, log2 fold change ${f.lfc.toFixed(2)}, p-value ${f.p.toPrecision(3)}`}><title>{f.id}: log2 fold change {f.lfc.toFixed(2)}; p-value {f.p.toPrecision(3)}</title></circle>)}</g>
            </svg>
            <figcaption>Log2 fold change (B / A)</figcaption>
            <div class="ms-plot-key"><span class="ms-key-down">Lower in B</span><span class="ms-key-ns">Below cut-offs</span><span class="ms-key-up">Higher in B</span></div>
          </figure>
          <div class="ms-inspector">
            <h3>Feature readout</h3>
            <p class="ms-inspect-hint">Hover or focus a point. Use Up and Down to move between features.</p>
            <dl class="ms-readout" aria-live="polite" aria-atomic="true">
              <div><dt>Feature</dt><dd data-ms-id>{first.id}</dd></div>
              <div><dt>Log2 change</dt><dd data-ms-fc data-illustrative>{first.lfc.toFixed(2)}</dd></div>
              <div><dt>p-value</dt><dd data-ms-pv data-illustrative>{first.p.toPrecision(3)}</dd></div>
            </dl>
            <div class="ms-controls" data-volcano-controls hidden>
              <label for="ms-fold">Minimum |log2 change| <output id="ms-fold-out" data-illustrative>1.0</output></label>
              <input id="ms-fold" type="range" min="0" max="3" step="0.1" value="1" />
              <label for="ms-p">Maximum p-value <output id="ms-p-out">0.05</output></label>
              <input id="ms-p" type="range" min="0.01" max="0.1" step="0.01" value="0.05" />
              <p data-ms-count role="status"></p>
            </div>
            <noscript><p>The dashed cut-offs mark |log2 change| ≥ 1 and p &lt; 0.05. Point titles contain feature values.</p></noscript>
          </div>
        </div>
      </Sheet>
      <Sheet id="ms-used" name="lab_notes" title="Where it was used" formula="I used the macro for human samples and the mouse study.">
        <div class="ms-lab stg">
          <div class="ms-samples">
            <h3>Mainly human samples</h3>
            <svg viewBox="0 0 410 142" role="img" aria-label="A rack of sample tubes for the human-sample workflow." set:html={Array.from({length: 10}, (_, i) => tube(5 + i * 40, 15, {s: .82, liq: 'lq-sage'})).join('') + '<path class="ms-rack" d="M0 76H406V128H0Z M0 100H406"/>'}/>
            <h3>Also the mouse study</h3>
            <svg viewBox="0 0 410 142" role="img" aria-label="A second rack of sample tubes for the mouse-study workflow." set:html={Array.from({length: 4}, (_, i) => tube(125 + i * 40, 15, {s: .82, liq: 'lq-blue'})).join('') + '<path class="ms-rack" d="M112 76H294V128H112Z M112 100H294"/>'}/>
          </div>
          <div class="ms-lab-computer">
            <svg viewBox="0 0 340 240" role="img" aria-label="A laptop showing the spreadsheet and volcano plot." set:html={laptop(20, 24, {s: 1.2}) + '<path class="ms-screen-grid" d="M53 64H250M53 82H250M53 100H160M53 118H160M85 47V144M118 47V144M151 47V144"/><path class="ms-mini-plot" d="M182 142V91M182 142H254"/><circle class="ms-mini-dot" cx="204" cy="114" r="4"/><circle class="ms-mini-dot" cx="224" cy="131" r="4"/><circle class="ms-mini-dot" cx="250" cy="104" r="4"/>'}/>
            <p>I wrote the macro so a bench scientist could review results without hand-formatting the export.</p>
          </div>
          <div class="ms-instrument">
            <svg viewBox="0 0 340 240" role="img" aria-label="Schematic of the Thermo Fisher Velos Pro: inlet, instrument housing and spectrum display.">
              <rect class="ms-housing" x="20" y="30" width="300" height="184" rx="8"/><path class="ms-instrument-line" d="M82 30V214M106 158H294M106 176H294M106 194H294"/>
              <rect class="ms-display" x="106" y="50" width="188" height="86" rx="3"/><path class="ms-spectrum" d="M120 119H148V96H152V119H175V72H179V119H206V87H210V119H280"/>
              <circle class="ms-port" cx="51" cy="138" r="13"/><circle class="ms-light" cx="51" cy="65" r="5"/>
            </svg>
            <p>I operated, maintained and calibrated the Thermo Fisher Velos Pro.</p>
          </div>
        </div>
        <div class="ms-close">
          <p>Cincinnati Children’s Research Foundation · Research Student II · {c.period}.</p>
          <a href="/evidence/#ledger-ms-reduction">Evidence ledger</a>
        </div>
      </Sheet>
      </div>
    </div>
  </div>
</WorldShell>
<script>import './workbook'; import './volcano';</script>
